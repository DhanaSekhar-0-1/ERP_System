{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "backend",
      "runtimeExecutable": "cmd",
      "runtimeArgs": ["/c", "set RAZORPAY_WEBHOOK_SECRET=dev_webhook_secret&& set CORS_ORIGINS=http://localhost:3001,http://localhost:8081&& cd backend && node dist/main.js"],
      "port": 3000,
      "url": "http://localhost:3000"
    },
    {
      "name": "web",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "dev", "--workspace", "@erp/web"],
      "port": 3001
    },
    {
      "name": "mobile-web-preview",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "web", "--workspace", "@erp/mobile"],
      "port": 8081
    }
  ]
}
