generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum UserStatus {
  ACTIVE
  INVITED
  SUSPENDED
  ARCHIVED
}

enum EnrollmentStatus {
  ACTIVE
  PROMOTED
  TRANSFERRED
  WITHDRAWN
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  LATE
  ON_LEAVE
  EXCUSED
}

enum HomeworkStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum SubmissionStatus {
  SUBMITTED
  GRADED
  RETURNED
}

enum AnnouncementStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum ApprovalStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

enum OverrideEffect {
  GRANT
  REVOKE
}

enum ExamStatus {
  DRAFT
  VERIFIED
  LOCKED
  RELEASED
}

enum MarkStatus {
  DRAFT
  SUBMITTED
}

enum FeeStructureStatus {
  DRAFT
  PENDING_APPROVAL
  APPROVED
  REJECTED
}

enum StudentFeeStatus {
  PENDING
  PARTIAL
  PAID
  CANCELLED
}

enum PaymentMethod {
  CASH
  UPI
  CARD
  BANK_TRANSFER
  CHEQUE
  ONLINE
}

enum PaymentStatus {
  PENDING
  VERIFIED
  REFUND_REQUESTED
  REFUNDED
  FAILED
}

enum LeaveStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

enum StaffLeaveType {
  CASUAL
  SICK
  EARNED
  UNPAID
}

enum TimetableStatus {
  DRAFT
  PUBLISHED
  LOCKED
}

enum SubstituteStatus {
  OPEN
  ASSIGNED
  CANCELLED
}

enum FeedbackStatus {
  NEW
  REVIEWED
  CLOSED
}

enum ComplaintStatus {
  SUBMITTED
  ASSIGNED
  INVESTIGATING
  RESOLVED
  REOPENED
  ESCALATED
}

enum CertificateType {
  BONAFIDE
  STUDY
  TRANSFER
  CHARACTER
}

enum CertificateStatus {
  DRAFT
  PENDING_APPROVAL
  APPROVED
  REJECTED
  ISSUED
}

enum DeliveryStatus {
  QUEUED
  SENT
  FAILED
}

enum BoardingType {
  BOARDED
  DROPPED
}

enum LibraryIssueStatus {
  ISSUED
  RETURNED
  LOST
}

enum AssetStatus {
  ACTIVE
  IN_MAINTENANCE
  DISPOSED
}

enum SyncStatus {
  PROCESSED
  PARTIAL
  FAILED
}

enum ConflictStatus {
  OPEN
  RESOLVED
}

model Organization {
  id        String   @id @default(uuid()) @db.Uuid
  name      String
  slug      String   @unique
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  schools   School[]
  users     User[]

  @@map("organizations")
}

model School {
  id                  String                @id @default(uuid()) @db.Uuid
  organizationId      String                @map("organization_id") @db.Uuid
  name                String
  code                String
  isArchived          Boolean               @default(false) @map("is_archived")
  createdAt           DateTime              @default(now()) @map("created_at")
  updatedAt           DateTime              @updatedAt @map("updated_at")
  organization        Organization          @relation(fields: [organizationId], references: [id])
  academicYears       AcademicYear[]
  users               User[]
  classes             SchoolClass[]
  sections            Section[]
  subjects            Subject[]
  students            Student[]
  guardians           Guardian[]
  staff               StaffProfile[]
  assignments         StaffAssignment[]
  enrollments         Enrollment[]
  auditLogs           AuditLog[]
  approvals           ApprovalRequest[]
  attendance          AttendanceRecord[]
  homework            Homework[]
  announcements       Announcement[]
  homeworkSubmissions HomeworkSubmission[]
  settings            SchoolSettings?
  examinations        Examination[]
  feeStructures       FeeStructure[]
  studentFees         StudentFee[]
  payments            Payment[]
  studentLeaves       StudentLeave[]
  staffLeaves         StaffLeave[]
  timetables          Timetable[]
  substitutes         SubstituteRequest[]
  feedback            Feedback[]
  complaints          Complaint[]
  files               FileAsset[]
  certificates        Certificate[]
  transportRoutes     TransportRoute[]
  buses               Bus[]
  drivers             Driver[]
  books               Book[]
  bookCategories      BookCategory[]
  assets              Asset[]
  syncBatches         SyncBatch[]
  securityEvents      SecurityEvent[]

  @@unique([organizationId, code])
  @@index([organizationId])
  @@map("schools")
}

model SchoolSettings {
  id        String   @id @default(uuid()) @db.Uuid
  schoolId  String   @unique @map("school_id") @db.Uuid
  address   String?
  phone     String?
  email     String?
  timezone  String   @default("UTC")
  metadata  Json?
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  school    School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  @@map("school_settings")
}

model AcademicYear {
  id               String             @id @default(uuid()) @db.Uuid
  schoolId         String             @map("school_id") @db.Uuid
  name             String
  startsOn         DateTime           @map("starts_on") @db.Date
  endsOn           DateTime           @map("ends_on") @db.Date
  isActive         Boolean            @default(false) @map("is_active")
  isClosed         Boolean            @default(false) @map("is_closed")
  createdAt        DateTime           @default(now()) @map("created_at")
  updatedAt        DateTime           @updatedAt @map("updated_at")
  school           School             @relation(fields: [schoolId], references: [id])
  sections         Section[]
  subjects         Subject[]
  classes          SchoolClass[]
  enrollments      Enrollment[]
  assignments      StaffAssignment[]
  homework         Homework[]
  examinations     Examination[]
  feeStructures    FeeStructure[]
  timetables       Timetable[]
  leaveEntitlements LeaveEntitlement[]

  @@unique([schoolId, name])
  @@index([schoolId, isActive])
  @@map("academic_years")
}

model User {
  id                  String               @id @default(uuid()) @db.Uuid
  organizationId      String?              @map("organization_id") @db.Uuid
  schoolId            String?              @map("school_id") @db.Uuid
  authUserId          String               @unique @map("auth_user_id") @db.Uuid
  email               String               @unique
  displayName         String               @map("display_name")
  phone               String?
  status              UserStatus           @default(INVITED)
  createdAt           DateTime             @default(now()) @map("created_at")
  updatedAt           DateTime             @updatedAt @map("updated_at")
  organization        Organization?        @relation(fields: [organizationId], references: [id])
  school              School?              @relation(fields: [schoolId], references: [id])
  staffProfile        StaffProfile?
  studentProfile      Student?
  guardian            Guardian?
  roles               UserRole[]
  auditLogs           AuditLog[]
  approvals           ApprovalRequest[]    @relation("ApprovalRequester")
  approvalDecisions   ApprovalDecision[]
  attendanceMarked    AttendanceRecord[]   @relation("AttendanceMarker")
  announcements       Announcement[]
  permissionOverrides PermissionOverride[]
  sessions            UserSession[]
  notifications       Notification[]
  notificationPreference NotificationPreference?
  devices             Device[]

  @@index([organizationId, schoolId])
  @@map("users")
}

model Role {
  id          String           @id @default(uuid()) @db.Uuid
  name        String           @unique
  description String?
  isSystem    Boolean          @default(false) @map("is_system")
  userRoles   UserRole[]
  permissions RolePermission[]

  @@map("roles")
}

model Permission {
  id          String               @id @default(uuid()) @db.Uuid
  code        String               @unique
  description String?
  roles       RolePermission[]
  overrides   PermissionOverride[]

  @@map("permissions")
}

model UserRole {
  userId String @map("user_id") @db.Uuid
  roleId String @map("role_id") @db.Uuid
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  role   Role   @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
  @@map("user_roles")
}

model RolePermission {
  roleId       String     @map("role_id") @db.Uuid
  permissionId String     @map("permission_id") @db.Uuid
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

model PermissionOverride {
  id           String         @id @default(uuid()) @db.Uuid
  userId       String         @map("user_id") @db.Uuid
  permissionId String         @map("permission_id") @db.Uuid
  effect       OverrideEffect
  reason       String?
  createdById  String?        @map("created_by_id") @db.Uuid
  createdAt    DateTime       @default(now()) @map("created_at")
  user         User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  permission   Permission     @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([userId, permissionId])
  @@map("permission_overrides")
}

model UserSession {
  id         String    @id @default(uuid()) @db.Uuid
  userId     String    @map("user_id") @db.Uuid
  sessionId  String    @unique @map("session_id")
  ipAddress  String?   @map("ip_address")
  userAgent  String?   @map("user_agent")
  createdAt  DateTime  @default(now()) @map("created_at")
  lastSeenAt DateTime  @default(now()) @map("last_seen_at")
  revokedAt  DateTime? @map("revoked_at")
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, revokedAt])
  @@map("user_sessions")
}

model LoginAttempt {
  id         String   @id @default(uuid()) @db.Uuid
  identifier String
  ipAddress  String?  @map("ip_address")
  success    Boolean
  createdAt  DateTime @default(now()) @map("created_at")

  @@index([identifier, createdAt])
  @@index([ipAddress, createdAt])
  @@map("login_attempts")
}

model SchoolClass {
  id                  String            @id @default(uuid()) @db.Uuid
  schoolId            String            @map("school_id") @db.Uuid
  academicYearId      String            @map("academic_year_id") @db.Uuid
  name                String
  sortOrder           Int               @default(0) @map("sort_order")
  createdAt           DateTime          @default(now()) @map("created_at")
  updatedAt           DateTime          @default(now()) @updatedAt @map("updated_at")
  school              School            @relation(fields: [schoolId], references: [id])
  academicYear        AcademicYear      @relation(fields: [academicYearId], references: [id])
  sections            Section[]
  enrollments         Enrollment[]
  assignments         StaffAssignment[]
  homework            Homework[]
  targetAnnouncements Announcement[]    @relation("AnnouncementTargetClass")
  assessments         Assessment[]
  feeStructures       FeeStructure[]

  @@unique([schoolId, academicYearId, name])
  @@map("classes")
}

model Section {
  id                  String            @id @default(uuid()) @db.Uuid
  schoolId            String            @map("school_id") @db.Uuid
  academicYearId      String            @map("academic_year_id") @db.Uuid
  classId             String            @map("class_id") @db.Uuid
  name                String
  isArchived          Boolean           @default(false) @map("is_archived")
  createdAt           DateTime          @default(now()) @map("created_at")
  updatedAt           DateTime          @default(now()) @updatedAt @map("updated_at")
  school              School            @relation(fields: [schoolId], references: [id])
  academicYear        AcademicYear      @relation(fields: [academicYearId], references: [id])
  class               SchoolClass       @relation(fields: [classId], references: [id])
  enrollments         Enrollment[]
  homework            Homework[]
  targetAnnouncements Announcement[]    @relation("AnnouncementTargetSection")
  assignments         StaffAssignment[]
  timetables          Timetable[]

  @@unique([classId, name])
  @@map("sections")
}

model Subject {
  id             String            @id @default(uuid()) @db.Uuid
  schoolId       String            @map("school_id") @db.Uuid
  academicYearId String            @map("academic_year_id") @db.Uuid
  name           String
  code           String
  createdAt      DateTime          @default(now()) @map("created_at")
  updatedAt      DateTime          @default(now()) @updatedAt @map("updated_at")
  school         School            @relation(fields: [schoolId], references: [id])
  academicYear   AcademicYear      @relation(fields: [academicYearId], references: [id])
  assignments    StaffAssignment[]
  homework       Homework[]
  assessments    Assessment[]
  timetableSlots TimetableSlot[]

  @@unique([schoolId, academicYearId, code])
  @@map("subjects")
}

model Student {
  id                  String                @id @default(uuid()) @db.Uuid
  schoolId            String                @map("school_id") @db.Uuid
  userId              String?               @unique @map("user_id") @db.Uuid
  admissionNo         String                @map("admission_no")
  nfcId               String?               @unique @map("nfc_id")
  firstName           String                @map("first_name")
  lastName            String?               @map("last_name")
  dateOfBirth         DateTime?             @map("date_of_birth") @db.Date
  phone               String?
  address             String?
  isArchived          Boolean               @default(false) @map("is_archived")
  createdAt           DateTime              @default(now()) @map("created_at")
  updatedAt           DateTime              @default(now()) @updatedAt @map("updated_at")
  school              School                @relation(fields: [schoolId], references: [id])
  user                User?                 @relation(fields: [userId], references: [id])
  guardians           StudentGuardian[]
  enrollments         Enrollment[]
  homeworkSubmissions HomeworkSubmission[]
  marks               Mark[]
  fees                StudentFee[]
  leaves              StudentLeave[]
  certificates        Certificate[]
  transportAllocations TransportAllocation[]
  boardingEvents      BoardingEvent[]
  libraryIssues       LibraryIssue[]

  @@unique([schoolId, admissionNo])
  @@index([schoolId])
  @@map("students")
}

model Guardian {
  id        String            @id @default(uuid()) @db.Uuid
  schoolId  String            @map("school_id") @db.Uuid
  userId    String?           @unique @map("user_id") @db.Uuid
  name      String
  phone     String?
  email     String?
  relation  String?
  address   String?
  createdAt DateTime          @default(now()) @map("created_at")
  updatedAt DateTime          @default(now()) @updatedAt @map("updated_at")
  school    School            @relation(fields: [schoolId], references: [id])
  user      User?             @relation(fields: [userId], references: [id])
  students  StudentGuardian[]

  @@index([schoolId])
  @@map("guardians")
}

model StudentGuardian {
  studentId  String   @map("student_id") @db.Uuid
  guardianId String   @map("guardian_id") @db.Uuid
  isPrimary  Boolean  @default(false) @map("is_primary")
  student    Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  guardian   Guardian @relation(fields: [guardianId], references: [id], onDelete: Cascade)

  @@id([studentId, guardianId])
  @@map("student_guardians")
}

model StaffProfile {
  id                  String              @id @default(uuid()) @db.Uuid
  userId              String              @unique @map("user_id") @db.Uuid
  schoolId            String              @map("school_id") @db.Uuid
  employeeNo          String              @map("employee_no")
  nfcId               String?             @unique @map("nfc_id")
  designation         String?
  createdAt           DateTime            @default(now()) @map("created_at")
  updatedAt           DateTime            @default(now()) @updatedAt @map("updated_at")
  user                User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  school              School              @relation(fields: [schoolId], references: [id])
  staffAssignments    StaffAssignment[]
  homework            Homework[]
  timetableSlots      TimetableSlot[]
  leaves              StaffLeave[]
  leaveEntitlements   LeaveEntitlement[]
  substituteOriginal  SubstituteRequest[] @relation("SubstituteOriginal")
  substituteAssigned  SubstituteRequest[] @relation("SubstituteAssigned")
  libraryIssues       LibraryIssue[]
  assets              Asset[]

  @@unique([schoolId, employeeNo])
  @@map("staff_profiles")
}

model StaffAssignment {
  id             String       @id @default(uuid()) @db.Uuid
  schoolId       String       @map("school_id") @db.Uuid
  academicYearId String       @map("academic_year_id") @db.Uuid
  staffId        String       @map("staff_id") @db.Uuid
  classId        String       @map("class_id") @db.Uuid
  sectionId      String?      @map("section_id") @db.Uuid
  subjectId      String       @map("subject_id") @db.Uuid
  isClassTeacher Boolean      @default(false) @map("is_class_teacher")
  effectiveFrom  DateTime?    @map("effective_from") @db.Date
  createdAt      DateTime     @default(now()) @map("created_at")
  updatedAt      DateTime     @default(now()) @updatedAt @map("updated_at")
  school         School       @relation(fields: [schoolId], references: [id])
  academicYear   AcademicYear @relation(fields: [academicYearId], references: [id])
  staff          StaffProfile @relation(fields: [staffId], references: [id])
  class          SchoolClass  @relation(fields: [classId], references: [id])
  section        Section?     @relation(fields: [sectionId], references: [id])
  subject        Subject      @relation(fields: [subjectId], references: [id])

  @@unique([staffId, classId, sectionId, subjectId, academicYearId])
  @@index([schoolId, academicYearId, classId])
  @@index([schoolId, staffId])
  @@map("staff_assignments")
}

model Enrollment {
  id             String             @id @default(uuid()) @db.Uuid
  schoolId       String             @map("school_id") @db.Uuid
  academicYearId String             @map("academic_year_id") @db.Uuid
  studentId      String             @map("student_id") @db.Uuid
  classId        String             @map("class_id") @db.Uuid
  sectionId      String             @map("section_id") @db.Uuid
  rollNumber     String?            @map("roll_number")
  status         EnrollmentStatus   @default(ACTIVE)
  createdAt      DateTime           @default(now()) @map("created_at")
  updatedAt      DateTime           @default(now()) @updatedAt @map("updated_at")
  school         School             @relation(fields: [schoolId], references: [id])
  academicYear   AcademicYear       @relation(fields: [academicYearId], references: [id])
  student        Student            @relation(fields: [studentId], references: [id])
  class          SchoolClass        @relation(fields: [classId], references: [id])
  section        Section            @relation(fields: [sectionId], references: [id])
  attendance     AttendanceRecord[]
  marks          Mark[]

  @@unique([studentId, academicYearId])
  @@index([schoolId, academicYearId, sectionId])
  @@map("student_enrollments")
}

model AttendanceRecord {
  id             String           @id @default(uuid()) @db.Uuid
  schoolId       String           @map("school_id") @db.Uuid
  enrollmentId   String           @map("enrollment_id") @db.Uuid
  attendanceDate DateTime         @map("attendance_date") @db.Date
  status         AttendanceStatus
  remarks        String?
  markedById     String?          @map("marked_by_id") @db.Uuid
  source         String           @default("MANUAL")
  createdAt      DateTime         @default(now()) @map("created_at")
  updatedAt      DateTime         @updatedAt @map("updated_at")
  school         School           @relation(fields: [schoolId], references: [id])
  enrollment     Enrollment       @relation(fields: [enrollmentId], references: [id])
  markedBy       User?            @relation("AttendanceMarker", fields: [markedById], references: [id], onDelete: SetNull)

  @@unique([enrollmentId, attendanceDate])
  @@index([schoolId, attendanceDate])
  @@index([schoolId, enrollmentId, attendanceDate])
  @@map("attendance_records")
}

model Homework {
  id             String               @id @default(uuid()) @db.Uuid
  schoolId       String               @map("school_id") @db.Uuid
  academicYearId String               @map("academic_year_id") @db.Uuid
  classId        String               @map("class_id") @db.Uuid
  sectionId      String               @map("section_id") @db.Uuid
  subjectId      String               @map("subject_id") @db.Uuid
  teacherId      String               @map("teacher_id") @db.Uuid
  title          String
  description    String?
  dueDate        DateTime?            @map("due_date") @db.Date
  maxMarks       Int?                 @map("max_marks")
  status         HomeworkStatus       @default(DRAFT)
  publishedAt    DateTime?            @map("published_at")
  createdAt      DateTime             @default(now()) @map("created_at")
  updatedAt      DateTime             @updatedAt @map("updated_at")
  school         School               @relation(fields: [schoolId], references: [id])
  academicYear   AcademicYear         @relation(fields: [academicYearId], references: [id])
  class          SchoolClass          @relation(fields: [classId], references: [id])
  section        Section              @relation(fields: [sectionId], references: [id])
  subject        Subject              @relation(fields: [subjectId], references: [id])
  teacher        StaffProfile         @relation(fields: [teacherId], references: [id], onDelete: Restrict)
  submissions    HomeworkSubmission[]

  @@index([schoolId, academicYearId, classId, sectionId])
  @@index([schoolId, teacherId, status])
  @@index([schoolId, status, publishedAt])
  @@map("homework")
}

model HomeworkSubmission {
  id            String           @id @default(uuid()) @db.Uuid
  schoolId      String           @map("school_id") @db.Uuid
  homeworkId    String           @map("homework_id") @db.Uuid
  studentId     String           @map("student_id") @db.Uuid
  content       String?
  attachmentUrl String?          @map("attachment_url")
  status        SubmissionStatus @default(SUBMITTED)
  isLate        Boolean          @default(false) @map("is_late")
  score         Decimal?         @db.Decimal(6, 2)
  feedback      String?
  gradedById    String?          @map("graded_by_id") @db.Uuid
  gradedAt      DateTime?        @map("graded_at")
  submittedAt   DateTime         @default(now()) @map("submitted_at")
  createdAt     DateTime         @default(now()) @map("created_at")
  updatedAt     DateTime         @updatedAt @map("updated_at")
  school        School           @relation(fields: [schoolId], references: [id])
  homework      Homework         @relation(fields: [homeworkId], references: [id])
  student       Student          @relation(fields: [studentId], references: [id])

  @@unique([homeworkId, studentId])
  @@index([schoolId, studentId, submittedAt])
  @@map("homework_submissions")
}

model Announcement {
  id              String             @id @default(uuid()) @db.Uuid
  schoolId        String             @map("school_id") @db.Uuid
  title           String
  content         String
  status          AnnouncementStatus @default(DRAFT)
  targetClassId   String?            @map("target_class_id") @db.Uuid
  targetSectionId String?            @map("target_section_id") @db.Uuid
  targetRole      String?            @map("target_role")
  targetMetadata  Json?              @map("target_metadata")
  publishedAt     DateTime?          @map("published_at")
  archivedAt      DateTime?          @map("archived_at")
  createdById     String             @map("created_by_id") @db.Uuid
  createdAt       DateTime           @default(now()) @map("created_at")
  updatedAt       DateTime           @updatedAt @map("updated_at")
  school          School             @relation(fields: [schoolId], references: [id])
  targetClass     SchoolClass?       @relation("AnnouncementTargetClass", fields: [targetClassId], references: [id], onDelete: SetNull)
  targetSection   Section?           @relation("AnnouncementTargetSection", fields: [targetSectionId], references: [id], onDelete: SetNull)
  createdBy       User               @relation(fields: [createdById], references: [id], onDelete: Restrict)

  @@index([schoolId, status, publishedAt])
  @@index([schoolId, targetClassId, targetSectionId])
  @@map("announcements")
}

model AuditLog {
  id                String   @id @default(uuid()) @db.Uuid
  userId            String?  @map("user_id") @db.Uuid
  schoolId          String?  @map("school_id") @db.Uuid
  organizationId    String?  @map("organization_id") @db.Uuid
  actorRole         String?  @map("actor_role")
  action            String
  entityType        String   @map("entity_type")
  entityId          String   @map("entity_id")
  fieldName         String?  @map("field_name")
  oldValue          Json?    @map("old_value")
  newValue          Json?    @map("new_value")
  reason            String?
  approvalRequestId String?  @map("approval_request_id") @db.Uuid
  requestId         String?  @map("request_id")
  ipAddress         String?  @map("ip_address")
  userAgent         String?  @map("user_agent")
  metadata          Json?
  createdAt         DateTime @default(now()) @map("created_at")
  user              User?    @relation(fields: [userId], references: [id])
  school            School?  @relation(fields: [schoolId], references: [id])

  @@index([schoolId, createdAt])
  @@index([entityType, entityId])
  @@index([userId, createdAt])
  @@map("audit_logs")
}

model SecurityEvent {
  id               String    @id @default(uuid()) @db.Uuid
  schoolId         String?   @map("school_id") @db.Uuid
  userId           String?   @map("user_id") @db.Uuid
  type             String
  severity         String    @default("LOW")
  description      String
  ipAddress        String?   @map("ip_address")
  metadata         Json?
  acknowledgedAt   DateTime? @map("acknowledged_at")
  acknowledgedById String?   @map("acknowledged_by_id") @db.Uuid
  createdAt        DateTime  @default(now()) @map("created_at")
  school           School?   @relation(fields: [schoolId], references: [id])

  @@index([schoolId, createdAt])
  @@index([type, createdAt])
  @@map("security_events")
}

model ApprovalRequest {
  id            String             @id @default(uuid()) @db.Uuid
  schoolId      String             @map("school_id") @db.Uuid
  requesterId   String             @map("requester_id") @db.Uuid
  type          String             @default("generic")
  entityType    String             @map("entity_type")
  entityId      String             @map("entity_id")
  reason        String
  payload       Json?
  tier          Int                @default(3)
  requiredRoles String[]           @default([]) @map("required_roles")
  documentFileId String?           @map("document_file_id") @db.Uuid
  status        ApprovalStatus     @default(PENDING)
  resolvedAt    DateTime?          @map("resolved_at")
  createdAt     DateTime           @default(now()) @map("created_at")
  updatedAt     DateTime           @updatedAt @map("updated_at")
  school        School             @relation(fields: [schoolId], references: [id])
  requester     User               @relation("ApprovalRequester", fields: [requesterId], references: [id])
  decisions     ApprovalDecision[]

  @@index([schoolId, status])
  @@index([entityType, entityId])
  @@map("approval_requests")
}

model ApprovalDecision {
  id         String          @id @default(uuid()) @db.Uuid
  requestId  String          @map("request_id") @db.Uuid
  approverId String          @map("approver_id") @db.Uuid
  role       String
  decision   ApprovalStatus
  note       String?
  createdAt  DateTime        @default(now()) @map("created_at")
  request    ApprovalRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  approver   User            @relation(fields: [approverId], references: [id])

  @@unique([requestId, role])
  @@map("approval_decisions")
}

model Examination {
  id             String       @id @default(uuid()) @db.Uuid
  schoolId       String       @map("school_id") @db.Uuid
  academicYearId String       @map("academic_year_id") @db.Uuid
  name           String
  term           String?
  startsOn       DateTime?    @map("starts_on") @db.Date
  endsOn         DateTime?    @map("ends_on") @db.Date
  status         ExamStatus   @default(DRAFT)
  verifiedAt     DateTime?    @map("verified_at")
  verifiedById   String?      @map("verified_by_id") @db.Uuid
  lockedAt       DateTime?    @map("locked_at")
  releasedAt     DateTime?    @map("released_at")
  releasedById   String?      @map("released_by_id") @db.Uuid
  createdAt      DateTime     @default(now()) @map("created_at")
  updatedAt      DateTime     @updatedAt @map("updated_at")
  school         School       @relation(fields: [schoolId], references: [id])
  academicYear   AcademicYear @relation(fields: [academicYearId], references: [id])
  assessments    Assessment[]

  @@unique([schoolId, academicYearId, name])
  @@map("examinations")
}

model Assessment {
  id            String      @id @default(uuid()) @db.Uuid
  schoolId      String      @map("school_id") @db.Uuid
  examinationId String      @map("examination_id") @db.Uuid
  classId       String      @map("class_id") @db.Uuid
  subjectId     String      @map("subject_id") @db.Uuid
  maxMarks      Decimal     @map("max_marks") @db.Decimal(6, 2)
  passMarks     Decimal?    @map("pass_marks") @db.Decimal(6, 2)
  examDate      DateTime?   @map("exam_date") @db.Date
  createdAt     DateTime    @default(now()) @map("created_at")
  updatedAt     DateTime    @updatedAt @map("updated_at")
  examination   Examination @relation(fields: [examinationId], references: [id])
  class         SchoolClass @relation(fields: [classId], references: [id])
  subject       Subject     @relation(fields: [subjectId], references: [id])
  marks         Mark[]

  @@unique([examinationId, classId, subjectId])
  @@map("assessments")
}

model Mark {
  id            String     @id @default(uuid()) @db.Uuid
  schoolId      String     @map("school_id") @db.Uuid
  assessmentId  String     @map("assessment_id") @db.Uuid
  studentId     String     @map("student_id") @db.Uuid
  enrollmentId  String     @map("enrollment_id") @db.Uuid
  marksObtained Decimal?   @map("marks_obtained") @db.Decimal(6, 2)
  isAbsent      Boolean    @default(false) @map("is_absent")
  remarks       String?
  status        MarkStatus @default(DRAFT)
  enteredById   String?    @map("entered_by_id") @db.Uuid
  submittedAt   DateTime?  @map("submitted_at")
  createdAt     DateTime   @default(now()) @map("created_at")
  updatedAt     DateTime   @updatedAt @map("updated_at")
  assessment    Assessment @relation(fields: [assessmentId], references: [id])
  student       Student    @relation(fields: [studentId], references: [id])
  enrollment    Enrollment @relation(fields: [enrollmentId], references: [id])

  @@unique([assessmentId, studentId])
  @@index([schoolId, studentId])
  @@map("marks")
}

model FeeStructure {
  id             String             @id @default(uuid()) @db.Uuid
  schoolId       String             @map("school_id") @db.Uuid
  academicYearId String             @map("academic_year_id") @db.Uuid
  classId        String?            @map("class_id") @db.Uuid
  name           String
  description    String?
  status         FeeStructureStatus @default(DRAFT)
  approvedById   String?            @map("approved_by_id") @db.Uuid
  approvedAt     DateTime?          @map("approved_at")
  createdAt      DateTime           @default(now()) @map("created_at")
  updatedAt      DateTime           @updatedAt @map("updated_at")
  school         School             @relation(fields: [schoolId], references: [id])
  academicYear   AcademicYear       @relation(fields: [academicYearId], references: [id])
  class          SchoolClass?       @relation(fields: [classId], references: [id])
  items          FeeItem[]
  studentFees    StudentFee[]

  @@unique([schoolId, academicYearId, name])
  @@map("fee_structures")
}

model FeeItem {
  id             String       @id @default(uuid()) @db.Uuid
  feeStructureId String       @map("fee_structure_id") @db.Uuid
  name           String
  amount         Decimal      @db.Decimal(12, 2)
  dueDate        DateTime?    @map("due_date") @db.Date
  feeStructure   FeeStructure @relation(fields: [feeStructureId], references: [id], onDelete: Cascade)

  @@map("fee_items")
}

model StudentFee {
  id             String           @id @default(uuid()) @db.Uuid
  schoolId       String           @map("school_id") @db.Uuid
  studentId      String           @map("student_id") @db.Uuid
  feeStructureId String           @map("fee_structure_id") @db.Uuid
  totalAmount    Decimal          @map("total_amount") @db.Decimal(12, 2)
  discountAmount Decimal          @default(0) @map("discount_amount") @db.Decimal(12, 2)
  paidAmount     Decimal          @default(0) @map("paid_amount") @db.Decimal(12, 2)
  status         StudentFeeStatus @default(PENDING)
  dueDate        DateTime?        @map("due_date") @db.Date
  createdAt      DateTime         @default(now()) @map("created_at")
  updatedAt      DateTime         @updatedAt @map("updated_at")
  school         School           @relation(fields: [schoolId], references: [id])
  student        Student          @relation(fields: [studentId], references: [id])
  feeStructure   FeeStructure     @relation(fields: [feeStructureId], references: [id])
  payments       Payment[]

  @@unique([studentId, feeStructureId])
  @@index([schoolId, status, dueDate])
  @@map("student_fees")
}

model Payment {
  id               String        @id @default(uuid()) @db.Uuid
  schoolId         String        @map("school_id") @db.Uuid
  studentFeeId     String        @map("student_fee_id") @db.Uuid
  amount           Decimal       @db.Decimal(12, 2)
  method           PaymentMethod
  status           PaymentStatus @default(PENDING)
  reference        String?
  gatewayOrderId   String?       @unique @map("gateway_order_id")
  gatewayPaymentId String?       @unique @map("gateway_payment_id")
  receiptNo        String?       @unique @map("receipt_no")
  paidAt           DateTime?     @map("paid_at")
  recordedById     String?       @map("recorded_by_id") @db.Uuid
  verifiedById     String?       @map("verified_by_id") @db.Uuid
  refundReason     String?       @map("refund_reason")
  createdAt        DateTime      @default(now()) @map("created_at")
  updatedAt        DateTime      @updatedAt @map("updated_at")
  school           School        @relation(fields: [schoolId], references: [id])
  studentFee       StudentFee    @relation(fields: [studentFeeId], references: [id])

  @@index([schoolId, status, paidAt])
  @@map("payments")
}

model PaymentWebhookEvent {
  id          String    @id @default(uuid()) @db.Uuid
  provider    String
  eventId     String    @map("event_id")
  payload     Json
  processedAt DateTime? @map("processed_at")
  createdAt   DateTime  @default(now()) @map("created_at")

  @@unique([provider, eventId])
  @@map("payment_webhook_events")
}

model StudentLeave {
  id            String      @id @default(uuid()) @db.Uuid
  schoolId      String      @map("school_id") @db.Uuid
  studentId     String      @map("student_id") @db.Uuid
  fromDate      DateTime    @map("from_date") @db.Date
  toDate        DateTime    @map("to_date") @db.Date
  reason        String
  status        LeaveStatus @default(PENDING)
  requestedById String      @map("requested_by_id") @db.Uuid
  decidedById   String?     @map("decided_by_id") @db.Uuid
  decisionNote  String?     @map("decision_note")
  decidedAt     DateTime?   @map("decided_at")
  createdAt     DateTime    @default(now()) @map("created_at")
  updatedAt     DateTime    @updatedAt @map("updated_at")
  school        School      @relation(fields: [schoolId], references: [id])
  student       Student     @relation(fields: [studentId], references: [id])

  @@index([schoolId, status])
  @@map("student_leaves")
}

model StaffLeave {
  id           String              @id @default(uuid()) @db.Uuid
  schoolId     String              @map("school_id") @db.Uuid
  staffId      String              @map("staff_id") @db.Uuid
  leaveType    StaffLeaveType      @map("leave_type")
  fromDate     DateTime            @map("from_date") @db.Date
  toDate       DateTime            @map("to_date") @db.Date
  days         Int
  reason       String
  status       LeaveStatus         @default(PENDING)
  decidedById  String?             @map("decided_by_id") @db.Uuid
  decisionNote String?             @map("decision_note")
  decidedAt    DateTime?           @map("decided_at")
  createdAt    DateTime            @default(now()) @map("created_at")
  updatedAt    DateTime            @updatedAt @map("updated_at")
  school       School              @relation(fields: [schoolId], references: [id])
  staff        StaffProfile        @relation(fields: [staffId], references: [id])
  substitutes  SubstituteRequest[]

  @@index([schoolId, status])
  @@map("staff_leaves")
}

model LeaveEntitlement {
  id             String         @id @default(uuid()) @db.Uuid
  staffId        String         @map("staff_id") @db.Uuid
  academicYearId String         @map("academic_year_id") @db.Uuid
  leaveType      StaffLeaveType @map("leave_type")
  days           Int
  staff          StaffProfile   @relation(fields: [staffId], references: [id], onDelete: Cascade)
  academicYear   AcademicYear   @relation(fields: [academicYearId], references: [id])

  @@unique([staffId, academicYearId, leaveType])
  @@map("leave_entitlements")
}

model Timetable {
  id             String          @id @default(uuid()) @db.Uuid
  schoolId       String          @map("school_id") @db.Uuid
  academicYearId String          @map("academic_year_id") @db.Uuid
  sectionId      String          @map("section_id") @db.Uuid
  status         TimetableStatus @default(DRAFT)
  createdAt      DateTime        @default(now()) @map("created_at")
  updatedAt      DateTime        @updatedAt @map("updated_at")
  school         School          @relation(fields: [schoolId], references: [id])
  academicYear   AcademicYear    @relation(fields: [academicYearId], references: [id])
  section        Section         @relation(fields: [sectionId], references: [id])
  slots          TimetableSlot[]

  @@unique([academicYearId, sectionId])
  @@map("timetables")
}

model TimetableSlot {
  id             String              @id @default(uuid()) @db.Uuid
  schoolId       String              @map("school_id") @db.Uuid
  timetableId    String              @map("timetable_id") @db.Uuid
  academicYearId String              @map("academic_year_id") @db.Uuid
  dayOfWeek      Int                 @map("day_of_week")
  periodNo       Int                 @map("period_no")
  subjectId      String              @map("subject_id") @db.Uuid
  staffId        String              @map("staff_id") @db.Uuid
  room           String?
  timetable      Timetable           @relation(fields: [timetableId], references: [id], onDelete: Cascade)
  subject        Subject             @relation(fields: [subjectId], references: [id])
  staff          StaffProfile        @relation(fields: [staffId], references: [id])
  substitutes    SubstituteRequest[]

  @@unique([timetableId, dayOfWeek, periodNo])
  @@unique([academicYearId, staffId, dayOfWeek, periodNo])
  @@index([academicYearId, room, dayOfWeek, periodNo])
  @@map("timetable_slots")
}

model SubstituteRequest {
  id                String           @id @default(uuid()) @db.Uuid
  schoolId          String           @map("school_id") @db.Uuid
  date              DateTime         @db.Date
  slotId            String           @map("slot_id") @db.Uuid
  originalStaffId   String           @map("original_staff_id") @db.Uuid
  substituteStaffId String?          @map("substitute_staff_id") @db.Uuid
  staffLeaveId      String?          @map("staff_leave_id") @db.Uuid
  status            SubstituteStatus @default(OPEN)
  reason            String?
  createdAt         DateTime         @default(now()) @map("created_at")
  updatedAt         DateTime         @updatedAt @map("updated_at")
  school            School           @relation(fields: [schoolId], references: [id])
  slot              TimetableSlot    @relation(fields: [slotId], references: [id])
  originalStaff     StaffProfile     @relation("SubstituteOriginal", fields: [originalStaffId], references: [id])
  substituteStaff   StaffProfile?    @relation("SubstituteAssigned", fields: [substituteStaffId], references: [id])
  staffLeave        StaffLeave?      @relation(fields: [staffLeaveId], references: [id])

  @@unique([slotId, date])
  @@index([schoolId, date])
  @@map("substitute_requests")
}

model Feedback {
  id             String         @id @default(uuid()) @db.Uuid
  schoolId       String         @map("school_id") @db.Uuid
  submittedById  String         @map("submitted_by_id") @db.Uuid
  category       String
  message        String
  isConfidential Boolean        @default(false) @map("is_confidential")
  targetStaffId  String?        @map("target_staff_id") @db.Uuid
  status         FeedbackStatus @default(NEW)
  response       String?
  createdAt      DateTime       @default(now()) @map("created_at")
  updatedAt      DateTime       @updatedAt @map("updated_at")
  school         School         @relation(fields: [schoolId], references: [id])

  @@index([schoolId, status])
  @@map("feedback")
}

model Complaint {
  id            String            @id @default(uuid()) @db.Uuid
  schoolId      String            @map("school_id") @db.Uuid
  submittedById String?           @map("submitted_by_id") @db.Uuid
  isAnonymous   Boolean           @default(false) @map("is_anonymous")
  category      String
  subject       String
  description   String
  aboutStaffId  String?           @map("about_staff_id") @db.Uuid
  studentId     String?           @map("student_id") @db.Uuid
  evidenceFileIds String[]        @default([]) @map("evidence_file_ids")
  status        ComplaintStatus   @default(SUBMITTED)
  assignedToId  String?           @map("assigned_to_id") @db.Uuid
  resolution    String?
  slaDueAt      DateTime          @map("sla_due_at")
  escalatedAt   DateTime?         @map("escalated_at")
  createdAt     DateTime          @default(now()) @map("created_at")
  updatedAt     DateTime          @updatedAt @map("updated_at")
  school        School            @relation(fields: [schoolId], references: [id])
  actions       ComplaintAction[]

  @@index([schoolId, status])
  @@index([schoolId, aboutStaffId])
  @@map("complaints")
}

model ComplaintAction {
  id          String    @id @default(uuid()) @db.Uuid
  complaintId String    @map("complaint_id") @db.Uuid
  actorId     String?   @map("actor_id") @db.Uuid
  action      String
  note        String?
  createdAt   DateTime  @default(now()) @map("created_at")
  complaint   Complaint @relation(fields: [complaintId], references: [id], onDelete: Cascade)

  @@index([complaintId, createdAt])
  @@map("complaint_actions")
}

model Notification {
  id         String                 @id @default(uuid()) @db.Uuid
  schoolId   String?                @map("school_id") @db.Uuid
  userId     String                 @map("user_id") @db.Uuid
  type       String
  title      String
  body       String
  data       Json?
  readAt     DateTime?              @map("read_at")
  createdAt  DateTime               @default(now()) @map("created_at")
  user       User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  deliveries NotificationDelivery[]

  @@index([userId, readAt, createdAt])
  @@map("notifications")
}

model NotificationDelivery {
  id             String         @id @default(uuid()) @db.Uuid
  notificationId String         @map("notification_id") @db.Uuid
  channel        String
  status         DeliveryStatus @default(QUEUED)
  error          String?
  createdAt      DateTime       @default(now()) @map("created_at")
  updatedAt      DateTime       @updatedAt @map("updated_at")
  notification   Notification   @relation(fields: [notificationId], references: [id], onDelete: Cascade)

  @@index([status, createdAt])
  @@map("notification_deliveries")
}

model NotificationPreference {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @unique @map("user_id") @db.Uuid
  inApp     Boolean  @default(true) @map("in_app")
  push      Boolean  @default(true)
  sms       Boolean  @default(false)
  email     Boolean  @default(false)
  digest    Boolean  @default(false)
  mutedTypes String[] @default([]) @map("muted_types")
  updatedAt DateTime @updatedAt @map("updated_at")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("notification_preferences")
}

model NotificationTemplate {
  id        String   @id @default(uuid()) @db.Uuid
  schoolId  String?  @map("school_id") @db.Uuid
  code      String
  channel   String
  subject   String?
  body      String
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([schoolId, code, channel])
  @@map("notification_templates")
}

model Device {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  token     String   @unique
  platform  String
  createdAt DateTime @default(now()) @map("created_at")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("devices")
}

model FileAsset {
  id           String    @id @default(uuid()) @db.Uuid
  schoolId     String    @map("school_id") @db.Uuid
  uploadedById String    @map("uploaded_by_id") @db.Uuid
  entityType   String?   @map("entity_type")
  entityId     String?   @map("entity_id")
  fileName     String    @map("file_name")
  mimeType     String    @map("mime_type")
  sizeBytes    Int       @map("size_bytes")
  storagePath  String    @unique @map("storage_path")
  deletedAt    DateTime? @map("deleted_at")
  createdAt    DateTime  @default(now()) @map("created_at")
  school       School    @relation(fields: [schoolId], references: [id])

  @@index([schoolId, entityType, entityId])
  @@map("file_assets")
}

model Certificate {
  id                String            @id @default(uuid()) @db.Uuid
  schoolId          String            @map("school_id") @db.Uuid
  studentId         String            @map("student_id") @db.Uuid
  type              CertificateType
  status            CertificateStatus @default(DRAFT)
  purpose           String?
  serialNo          String?           @unique @map("serial_no")
  content           Json?
  approvalRequestId String?           @map("approval_request_id") @db.Uuid
  issuedAt          DateTime?         @map("issued_at")
  issuedById        String?           @map("issued_by_id") @db.Uuid
  version           Int               @default(1)
  supersedesId      String?           @map("supersedes_id") @db.Uuid
  createdById       String            @map("created_by_id") @db.Uuid
  createdAt         DateTime          @default(now()) @map("created_at")
  updatedAt         DateTime          @updatedAt @map("updated_at")
  school            School            @relation(fields: [schoolId], references: [id])
  student           Student           @relation(fields: [studentId], references: [id])

  @@index([schoolId, studentId])
  @@map("certificates")
}

model TransportRoute {
  id          String                @id @default(uuid()) @db.Uuid
  schoolId    String                @map("school_id") @db.Uuid
  code        String
  name        String
  description String?
  isActive    Boolean               @default(true) @map("is_active")
  createdAt   DateTime              @default(now()) @map("created_at")
  updatedAt   DateTime              @updatedAt @map("updated_at")
  school      School                @relation(fields: [schoolId], references: [id])
  stops       TransportStop[]
  buses       Bus[]
  allocations TransportAllocation[]

  @@unique([schoolId, code])
  @@map("transport_routes")
}

model TransportStop {
  id          String                @id @default(uuid()) @db.Uuid
  schoolId    String                @map("school_id") @db.Uuid
  routeId     String                @map("route_id") @db.Uuid
  name        String
  sequence    Int
  pickupTime  String?               @map("pickup_time")
  dropTime    String?               @map("drop_time")
  route       TransportRoute        @relation(fields: [routeId], references: [id])
  allocations TransportAllocation[]

  @@unique([routeId, sequence])
  @@map("transport_stops")
}

model Bus {
  id             String          @id @default(uuid()) @db.Uuid
  schoolId       String          @map("school_id") @db.Uuid
  registrationNo String          @map("registration_no")
  capacity       Int
  routeId        String?         @map("route_id") @db.Uuid
  isActive       Boolean         @default(true) @map("is_active")
  school         School          @relation(fields: [schoolId], references: [id])
  route          TransportRoute? @relation(fields: [routeId], references: [id])
  drivers        Driver[]
  boardingEvents BoardingEvent[]

  @@unique([schoolId, registrationNo])
  @@map("buses")
}

model Driver {
  id        String  @id @default(uuid()) @db.Uuid
  schoolId  String  @map("school_id") @db.Uuid
  name      String
  phone     String
  licenseNo String  @map("license_no")
  role      String  @default("DRIVER")
  busId     String? @map("bus_id") @db.Uuid
  isActive  Boolean @default(true) @map("is_active")
  school    School  @relation(fields: [schoolId], references: [id])
  bus       Bus?    @relation(fields: [busId], references: [id])

  @@unique([schoolId, licenseNo])
  @@map("drivers")
}

model TransportAllocation {
  id        String         @id @default(uuid()) @db.Uuid
  schoolId  String         @map("school_id") @db.Uuid
  studentId String         @map("student_id") @db.Uuid
  routeId   String         @map("route_id") @db.Uuid
  stopId    String         @map("stop_id") @db.Uuid
  isActive  Boolean        @default(true) @map("is_active")
  createdAt DateTime       @default(now()) @map("created_at")
  updatedAt DateTime       @updatedAt @map("updated_at")
  student   Student        @relation(fields: [studentId], references: [id])
  route     TransportRoute @relation(fields: [routeId], references: [id])
  stop      TransportStop  @relation(fields: [stopId], references: [id])

  @@index([schoolId, studentId, isActive])
  @@map("transport_allocations")
}

model BoardingEvent {
  id           String       @id @default(uuid()) @db.Uuid
  schoolId     String       @map("school_id") @db.Uuid
  studentId    String       @map("student_id") @db.Uuid
  busId        String?      @map("bus_id") @db.Uuid
  type         BoardingType
  nfcId        String?      @map("nfc_id")
  occurredAt   DateTime     @default(now()) @map("occurred_at")
  recordedById String?      @map("recorded_by_id") @db.Uuid
  student      Student      @relation(fields: [studentId], references: [id])
  bus          Bus?         @relation(fields: [busId], references: [id])

  @@index([schoolId, occurredAt])
  @@map("boarding_events")
}

model BookCategory {
  id       String @id @default(uuid()) @db.Uuid
  schoolId String @map("school_id") @db.Uuid
  name     String
  school   School @relation(fields: [schoolId], references: [id])
  books    Book[]

  @@unique([schoolId, name])
  @@map("book_categories")
}

model Book {
  id         String         @id @default(uuid()) @db.Uuid
  schoolId   String         @map("school_id") @db.Uuid
  categoryId String?        @map("category_id") @db.Uuid
  title      String
  author     String?
  isbn       String?
  copies     Int            @default(1)
  available  Int            @default(1)
  createdAt  DateTime       @default(now()) @map("created_at")
  updatedAt  DateTime       @updatedAt @map("updated_at")
  school     School         @relation(fields: [schoolId], references: [id])
  category   BookCategory?  @relation(fields: [categoryId], references: [id])
  issues     LibraryIssue[]

  @@index([schoolId, title])
  @@map("books")
}

model LibraryIssue {
  id         String             @id @default(uuid()) @db.Uuid
  schoolId   String             @map("school_id") @db.Uuid
  bookId     String             @map("book_id") @db.Uuid
  studentId  String?            @map("student_id") @db.Uuid
  staffId    String?            @map("staff_id") @db.Uuid
  issuedAt   DateTime           @default(now()) @map("issued_at")
  dueDate    DateTime           @map("due_date") @db.Date
  returnedAt DateTime?          @map("returned_at")
  status     LibraryIssueStatus @default(ISSUED)
  book       Book               @relation(fields: [bookId], references: [id])
  student    Student?           @relation(fields: [studentId], references: [id])
  staff      StaffProfile?      @relation(fields: [staffId], references: [id])
  fines      LibraryFine[]

  @@index([schoolId, status])
  @@map("library_issues")
}

model LibraryFine {
  id         String       @id @default(uuid()) @db.Uuid
  schoolId   String       @map("school_id") @db.Uuid
  issueId    String       @map("issue_id") @db.Uuid
  amount     Decimal      @db.Decimal(10, 2)
  reason     String
  isWaived   Boolean      @default(false) @map("is_waived")
  waivedById String?      @map("waived_by_id") @db.Uuid
  paidAt     DateTime?    @map("paid_at")
  createdAt  DateTime     @default(now()) @map("created_at")
  issue      LibraryIssue @relation(fields: [issueId], references: [id])

  @@map("library_fines")
}

model Asset {
  id                String        @id @default(uuid()) @db.Uuid
  schoolId          String        @map("school_id") @db.Uuid
  assetTag          String        @map("asset_tag")
  name              String
  category          String
  location          String?
  condition         String?
  status            AssetStatus   @default(ACTIVE)
  assignedToStaffId String?       @map("assigned_to_staff_id") @db.Uuid
  purchaseDate      DateTime?     @map("purchase_date") @db.Date
  purchaseCost      Decimal?      @map("purchase_cost") @db.Decimal(12, 2)
  createdAt         DateTime      @default(now()) @map("created_at")
  updatedAt         DateTime      @updatedAt @map("updated_at")
  school            School        @relation(fields: [schoolId], references: [id])
  assignedTo        StaffProfile? @relation(fields: [assignedToStaffId], references: [id])
  events            AssetEvent[]

  @@unique([schoolId, assetTag])
  @@map("assets")
}

model AssetEvent {
  id        String   @id @default(uuid()) @db.Uuid
  assetId   String   @map("asset_id") @db.Uuid
  type      String
  note      String?
  data      Json?
  actorId   String?  @map("actor_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")
  asset     Asset    @relation(fields: [assetId], references: [id])

  @@index([assetId, createdAt])
  @@map("asset_events")
}

model SyncBatch {
  id            String         @id @default(uuid()) @db.Uuid
  schoolId      String         @map("school_id") @db.Uuid
  userId        String         @map("user_id") @db.Uuid
  deviceId      String?        @map("device_id")
  type          String
  status        SyncStatus
  itemCount     Int            @map("item_count")
  appliedCount  Int            @map("applied_count")
  conflictCount Int            @map("conflict_count")
  results       Json?
  createdAt     DateTime       @default(now()) @map("created_at")
  school        School         @relation(fields: [schoolId], references: [id])
  conflicts     SyncConflict[]

  @@index([schoolId, userId, createdAt])
  @@map("sync_batches")
}

model SyncConflict {
  id             String         @id @default(uuid()) @db.Uuid
  schoolId       String         @map("school_id") @db.Uuid
  batchId        String         @map("batch_id") @db.Uuid
  entityType     String         @map("entity_type")
  entityId       String?        @map("entity_id")
  clientPayload  Json           @map("client_payload")
  serverPayload  Json?          @map("server_payload")
  status         ConflictStatus @default(OPEN)
  resolution     String?
  resolvedById   String?        @map("resolved_by_id") @db.Uuid
  resolvedAt     DateTime?      @map("resolved_at")
  createdAt      DateTime       @default(now()) @map("created_at")
  batch          SyncBatch      @relation(fields: [batchId], references: [id])

  @@index([schoolId, status])
  @@map("sync_conflicts")
}
