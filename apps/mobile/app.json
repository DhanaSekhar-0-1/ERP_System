{
  "expo": {
    "name": "School ERP",
    "slug": "school-erp",
    "scheme": "schoolerp",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.schoolerp.attendance"
    },
    "android": {
      "package": "com.schoolerp.attendance",
      "permissions": [
        "android.permission.NFC",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ],
      "adaptiveIcon": {
        "backgroundColor": "#4F46E5",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "bundler": "metro",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-secure-store",
      "./plugins/with-short-native-paths",
      [
        "expo-build-properties",
        {
          "android": {
            "usesCleartextTraffic": true
          }
        }
      ],
      [
        "react-native-nfc-manager",
        {
          "nfcPermission": "Reads student ID cards to mark attendance"
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Checks that you are at school when you check in or out. Only the distance from school is saved."
        }
      ]
    ],
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "94df8782-b280-449a-9ccd-8a4767967002"
      }
    },
    "owner": "dhana9572"
  }
}
